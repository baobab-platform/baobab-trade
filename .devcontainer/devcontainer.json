{
  "name": "Nabhold baobab-trade",
  "image": "ghcr.io/baobab-platform/baobab-dev:1.4.4",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "init": true,
  "postCreateCommand": "test \"$(node --version)\" = v26.13.0 && baobab-verify --contract && npm ci --ignore-scripts && npm run typecheck",
  "customizations": {
    "vscode": {
      "extensions": [
        "github.vscode-github-actions",
        "redhat.vscode-yaml"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "26.13.0"
    }
  }
}
