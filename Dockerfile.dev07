# Disposable source/component tool, never the production Trade runtime image.
FROM node:24.21.0-alpine3.24@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1
WORKDIR /app
# Keep the source tool unprivileged while matching the disposable run owner.
# Codespaces/Actions may remap the remote UID; hard-coded node:1000 cannot
# write Medusa's runtime caches and must not own a private OAuth packet.
ARG BAOBAB_DEV07_UID=1000
ARG BAOBAB_DEV07_GID=1000
RUN apk add --no-cache git && git config --system --add safe.directory /app
COPY package*.json ./
RUN npm ci --include=dev
COPY . .
RUN chown -R ${BAOBAB_DEV07_UID}:${BAOBAB_DEV07_GID} /app
ENV NODE_ENV=test
USER ${BAOBAB_DEV07_UID}:${BAOBAB_DEV07_GID}
CMD ["npm", "run", "qualify:dev07-iam-cp"]
