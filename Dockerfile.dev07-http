# Disposable full Medusa HTTP source tool, never the production Trade runtime image.
FROM node:26.13.0-alpine3.24@sha256:c6ad9e9c1d80f6eb607c26b4b0a132ff7a2344fad1c78ea3baa2a7d4c8de6d94
WORKDIR /app
# Keep the source tool unprivileged while matching the disposable run owner.
# Codespaces/Actions may remap the remote UID; hard-coded node:1000 cannot
# write Medusa's runtime caches and must not own a private OAuth packet.
ARG BAOBAB_DEV07_UID=1000
ARG BAOBAB_DEV07_GID=1000
RUN apk add --no-cache git && git config --system --add safe.directory /app
COPY package*.json ./
RUN npm ci --include=dev
COPY . .
RUN npm run build
RUN chown -R ${BAOBAB_DEV07_UID}:${BAOBAB_DEV07_GID} /app
ENV NODE_ENV=test
# Numeric run identities have no guaranteed passwd home; keep npm/Medusa
# caches beneath the owned working directory rather than /root or /home/node.
ENV HOME=/app
ENV npm_config_cache=/app/.npm-cache
USER ${BAOBAB_DEV07_UID}:${BAOBAB_DEV07_GID}
EXPOSE 9000
CMD ["sh", "-c", "cd /app/.medusa/server && exec node /app/node_modules/@medusajs/cli/cli.js start"]
